# ── Environment ───────────────────────────────────────────────────
# "production" enforces a real SECRET_KEY, disables the MySQL→SQLite
# fallback and the any-localhost CORS rule.
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────
# Either set DATABASE_URL directly (relative SQLite paths resolve to backend/) ...
DATABASE_URL=sqlite:///./relaydesk.db
# ... or leave it empty and use the MySQL settings below.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=relaydesk
DB_USER=root
DB_PASSWORD=your_mysql_password

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_super_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=relaydesk_session

# ── Auth rate limits (per server process) ─────────────────────────
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_SECONDS=900
REGISTER_MAX_PER_IP=10
REGISTER_WINDOW_SECONDS=3600

# ── Paid services: OFF ────────────────────────────────────────────
# This project runs strictly free. The Claude API is billed per request,
# so nothing is ever sent to it while ENABLE_PAID_AI=false — even if a key
# is filled in below. The chatbot uses the free built-in engine.
ENABLE_PAID_AI=false
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=120
# Re-run requests a safety classifier declines on Anthropic's recommended fallback model
AI_REFUSAL_FALLBACK=true

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Extra comma-separated origins, e.g. https://desk.example.com
CORS_ORIGINS=
